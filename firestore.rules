rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isManager() {
      return isAuthenticated() && exists(/databases/$(database)/documents/managers/$(request.auth.uid));
    }
    function isCrew() {
      return isAuthenticated() && exists(/databases/$(database)/documents/crew/$(request.auth.uid));
    }
    function isStaff() { return isCrew() || isManager(); }
    function isOwner(userIdField) {
      return isAuthenticated() && request.resource.data[userIdField] == request.auth.uid;
    }

    // Match the dashboard's four unrestricted roles. Other manager roles must
    // be explicitly enabled for each module in settings/accessConfig.
    function isSecurityAdmin() {
      return isManager() && get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.role in
        ['Owner', 'owner', 'Super Admin', 'super admin', 'Admin', 'admin', 'System Admin', 'system admin'];
    }
    function hasManagerAccess(moduleId) {
      return isManager() && (isSecurityAdmin() || (
        exists(/databases/$(database)/documents/settings/accessConfig) &&
        get(/databases/$(database)/documents/settings/accessConfig).data.keys().hasAll([moduleId]) &&
        get(/databases/$(database)/documents/settings/accessConfig).data[moduleId].hasAny([
          get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.role
        ])
      ));
    }
    function canManagePeople() { return hasManagerAccess('EMPLOYEE'); }
    function canReadCrew() {
      return canManagePeople() || hasManagerAccess('TASKS') || hasManagerAccess('SHIFTS') ||
        hasManagerAccess('HR') || hasManagerAccess('REPORTS') || hasManagerAccess('ATTENDANCE') ||
        hasManagerAccess('EOM');
    }
    function canReadReportsData() { return hasManagerAccess('REPORTS'); }
    // Store Managers are trusted training managers in the current two-outlet
    // operating model. This can later be replaced with outlet assignments.
    function hasTrainingAccess() {
      return isManager() && (hasManagerAccess('TRAINING') ||
        get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.role in
          ['Store Manager', 'Store manager', 'store Manager', 'store manager', 'STORE MANAGER']);
    }
    function canTrainAtOutlet(outletId) {
      return isSecurityAdmin() || (hasTrainingAccess() &&
        get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.outletId == outletId);
    }

    match /{document=**} { allow read, write: if false; }

    match /managers/{managerId} {
      // Legacy profiles may still use a generated document ID even though the
      // corresponding Firebase Auth ID is stored in authUid. Let an
      // authenticated manager read only their own matching profile so they
      // can complete the one-time ID repair; no other profile becomes visible.
      allow read: if (isAuthenticated() && (request.auth.uid == managerId || resource.data.authUid == request.auth.uid)) || canManagePeople();
      allow create, update, delete: if canManagePeople();
    }
    match /crew/{crewId} {
      // The same narrowly scoped legacy-login bridge as /managers above.
      allow read: if (isAuthenticated() && (request.auth.uid == crewId || resource.data.authUid == request.auth.uid)) || canReadCrew() || canTrainAtOutlet(resource.data.outletId);
      allow create, delete: if canManagePeople();
      allow update: if canManagePeople() ||
        (hasManagerAccess('HR') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['documents'])) ||
        (hasManagerAccess('ATTENDANCE') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaveBalanceOverride', 'leaveBalanceOverrideDate']));
    }
    match /crewDirectory/{crewId} {
      allow read: if isStaff();
      allow write: if canManagePeople();
    }
    match /roles/{roleId} {
      allow read: if isStaff();
      allow write: if canManagePeople();
    }
    match /stores/{storeId} {
      allow read: if isStaff();
      allow write: if hasManagerAccess('STORES');
    }

    match /validations/{orderId} {
      allow read: if isCrew() || hasManagerAccess('ACCURACY') || hasManagerAccess('SETTINGS');
      allow create: if hasManagerAccess('ACCURACY') || (isCrew() && isOwner('validatedByCrewId'));
      allow update, delete: if hasManagerAccess('ACCURACY') || hasManagerAccess('SETTINGS');
    }
    match /tasks/{taskId} {
      allow read: if isCrew() || hasManagerAccess('TASKS') || canReadReportsData() || hasManagerAccess('SETTINGS');
      allow create, update: if hasManagerAccess('TASKS');
      allow delete: if hasManagerAccess('TASKS') || hasManagerAccess('SETTINGS');
    }
    match /taskTemplates/{templateId} {
      allow read: if isCrew() || hasManagerAccess('TASKS');
      allow write: if hasManagerAccess('TASKS');
    }
    match /taskLogs/{logId} {
      allow read: if isCrew() || hasManagerAccess('TASKS') || canReadReportsData() || hasManagerAccess('SETTINGS');
      allow create: if hasManagerAccess('TASKS') || (isCrew() && isOwner('crewId'));
      allow update: if hasManagerAccess('TASKS') || (isCrew() && resource.data.crewId == request.auth.uid);
      allow delete: if hasManagerAccess('TASKS') || hasManagerAccess('SETTINGS');
    }
    // Management follow-ups shown in the Daily Manager Overview use the same
    // explicitly granted REPORTS access that unlocks that view.
    match /managerActions/{actionId} {
      allow read, write: if hasManagerAccess('REPORTS');
    }

    match /attendanceLogs/{logId} {
      allow read: if isCrew() || hasManagerAccess('ATTENDANCE') || canReadReportsData() || hasManagerAccess('SETTINGS');
      allow create: if hasManagerAccess('ATTENDANCE') ||
        (isCrew() && isOwner('crewId') && request.resource.data.timestamp == request.time);
      allow update: if hasManagerAccess('ATTENDANCE') || (
        isCrew() && resource.data.crewId == request.auth.uid && resource.data.type == 'CHECK_OUT' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timestamp', 'method']) &&
        request.resource.data.timestamp == request.time
      );
      allow delete: if hasManagerAccess('ATTENDANCE') || hasManagerAccess('SETTINGS');
    }
    match /leaveRequests/{requestId} {
      allow read: if isCrew() || hasManagerAccess('ATTENDANCE');
      allow create: if hasManagerAccess('ATTENDANCE') ||
        (isCrew() && isOwner('crewId') && request.resource.data.status == 'PENDING');
      allow update, delete: if hasManagerAccess('ATTENDANCE');
    }
    match /shifts/{shiftId} {
      allow read: if isCrew() || hasManagerAccess('SHIFTS') || canReadReportsData() || hasManagerAccess('SETTINGS');
      allow create, update: if hasManagerAccess('SHIFTS');
      allow delete: if hasManagerAccess('SHIFTS') || hasManagerAccess('SETTINGS');
    }
    match /shiftAssignments/{assignId} {
      allow read: if isCrew() || hasManagerAccess('SHIFTS') || canReadReportsData() || hasManagerAccess('SETTINGS');
      allow create, update: if hasManagerAccess('SHIFTS');
      allow delete: if hasManagerAccess('SHIFTS') || hasManagerAccess('SETTINGS');
    }
    match /cafeHolidays/{holidayId} {
      allow read: if isCrew() || hasManagerAccess('SHIFTS') || canReadReportsData();
      allow write: if hasManagerAccess('SHIFTS');
    }

    // The logo is intentionally public for the login screen and locked kiosk.
    match /settings/companyLogo { allow read: if true; allow write: if hasManagerAccess('HR'); }
    match /settings/accessConfig { allow read: if isStaff(); allow write: if isSecurityAdmin(); }
    match /settings/appConfig { allow read: if isStaff(); allow write: if hasManagerAccess('STORES'); }
    match /settings/attendanceConfig { allow read: if isStaff(); allow write: if hasManagerAccess('ATTENDANCE'); }
    match /settings/taskConfig { allow read: if isCrew() || hasManagerAccess('TASKS'); allow write: if hasManagerAccess('TASKS'); }
    match /settings/recipeConfig { allow read: if isCrew() || hasManagerAccess('RECIPE'); allow write: if hasManagerAccess('RECIPE'); }
    match /settings/hrTemplates { allow read, write: if hasManagerAccess('HR'); }
    match /settings/hrConfig { allow read, write: if hasManagerAccess('HR'); }

    match /eom_cycles/{docId} { allow read: if isCrew() || hasManagerAccess('EOM'); allow write: if hasManagerAccess('EOM'); }
    match /eom_votes/{voteId} {
      allow read: if isCrew() || hasManagerAccess('EOM') || hasManagerAccess('SETTINGS');
      allow create: if hasManagerAccess('EOM') || (isCrew() && isOwner('voterId') && voteId == request.resource.data.cycleId + '_' + request.auth.uid);
      allow delete: if hasManagerAccess('SETTINGS');
    }
    match /eom_scores/{docId} { allow read: if isCrew() || hasManagerAccess('EOM'); allow write: if hasManagerAccess('EOM'); }

    match /recipes/{recipeId} {
      allow read: if hasManagerAccess('RECIPE') || (isCrew() && resource.data.isShared == true);
      allow write: if hasManagerAccess('RECIPE');
    }
    match /loginLogs/{logId} {
      allow read: if hasManagerAccess('LOGIN_ACTIVITY');
      allow create: if hasManagerAccess('LOGIN_ACTIVITY') || (isCrew() && isOwner('userId'));
      allow update: if hasManagerAccess('LOGIN_ACTIVITY');
      allow delete: if canTrainAtOutlet(resource.data.outletId);
    }

    // Training content, progress, and certification are deliberately split.
    // Learners can never write a pass, practical result, or certification.
    match /trainingModules/{moduleId} {
      allow read: if isManager() && hasTrainingAccess() ||
        (isCrew() && resource.data.status == 'PUBLISHED' &&
          resource.data.applicableOutletIds.hasAny([get(/databases/$(database)/documents/crew/$(request.auth.uid)).data.outletId]) &&
          (resource.data.applicableRoles.size() == 0 || resource.data.applicableRoles.hasAny([get(/databases/$(database)/documents/crew/$(request.auth.uid)).data.role])));
      // Managers who have the Training module permission can maintain training
      // content. Learners can only read published, role/outlet-relevant content.
      allow create, update, delete: if hasTrainingAccess();
      match /versions/{versionId} {
        allow read: if isManager() && hasTrainingAccess() ||
          (isCrew() && resource.data.status == 'PUBLISHED' && resource.data.applicableOutletIds.hasAny([get(/databases/$(database)/documents/crew/$(request.auth.uid)).data.outletId]));
        allow write: if hasTrainingAccess();
      }
    }
    // Answer keys are never readable by employees; trusted server code grades quizzes.
    match /trainingAssessmentKeys/{keyId} { allow read, write: if hasTrainingAccess(); }
    match /trainingAssignments/{assignmentId} {
      allow read: if isAuthenticated() && resource.data.employeeUid == request.auth.uid || canTrainAtOutlet(resource.data.outletId);
      allow create: if canTrainAtOutlet(request.resource.data.outletId);
      allow update: if (canTrainAtOutlet(resource.data.outletId) &&
          (request.resource.data.status != 'PASSED' ||
            (request.resource.data.practicalAssessment.result == 'PASSED' && request.resource.data.practicalAssessment.criticalFailure == false))) ||
        (isAuthenticated() && resource.data.employeeUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedLessonIds', 'acknowledgementAt', 'practicalAssessmentRequestedAt', 'updatedAt']) &&
          request.resource.data.status in ['ASSIGNED', 'NOT_STARTED', 'LEARNING', 'ASSESSMENT_PENDING', 'COMPLETED'] &&
          (request.resource.data.status != 'COMPLETED' || resource.data.trainingFormat == 'THEORETICAL'));
      allow delete: if isSecurityAdmin();
    }
    match /trainingCertifications/{certificationId} {
      allow read: if isAuthenticated() && resource.data.employeeUid == request.auth.uid || canTrainAtOutlet(resource.data.outletId);
      allow create: if canTrainAtOutlet(request.resource.data.outletId) &&
        request.resource.data.employeeUid != request.auth.uid &&
        get(/databases/$(database)/documents/trainingAssignments/$(request.resource.data.assignmentId)).data.status == 'PASSED' &&
        get(/databases/$(database)/documents/trainingAssignments/$(request.resource.data.assignmentId)).data.employeeUid == request.resource.data.employeeUid &&
        (request.resource.data.role != 'Manager' || isSecurityAdmin());
      allow update, delete: if false;
    }
    match /trainingAudit/{eventId} {
      allow read: if isManager() && hasTrainingAccess();
      allow create: if isManager() && hasTrainingAccess();
      allow update, delete: if false;
    }
  }
}
