rules_version = '2';

// The file rules enforce the same manager-module matrix as Firestore. Bare
// Firebase authentication is deliberately insufficient because email/password
// sign-up is enabled for this project.
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() { return request.auth != null; }
    function isManager() {
      return isAuthenticated() && firestore.exists(/databases/(default)/documents/managers/$(request.auth.uid));
    }
    function isCrew() {
      return isAuthenticated() && firestore.exists(/databases/(default)/documents/crew/$(request.auth.uid));
    }
    function isStaff() { return isCrew() || isManager(); }
    function isSecurityAdmin() {
      return isManager() && firestore.get(/databases/(default)/documents/managers/$(request.auth.uid)).data.role in
        ['Owner', 'owner', 'Super Admin', 'super admin', 'Admin', 'admin', 'System Admin', 'system admin'];
    }
    function hasManagerAccess(moduleId) {
      return isManager() && (isSecurityAdmin() || (
        firestore.exists(/databases/(default)/documents/settings/accessConfig) &&
        firestore.get(/databases/(default)/documents/settings/accessConfig).data.keys().hasAll([moduleId]) &&
        firestore.get(/databases/(default)/documents/settings/accessConfig).data[moduleId].hasAny([
          firestore.get(/databases/(default)/documents/managers/$(request.auth.uid)).data.role
        ])
      ));
    }
    function hasTrainingAccess() {
      return isManager() && (hasManagerAccess('TRAINING') ||
        firestore.get(/databases/(default)/documents/managers/$(request.auth.uid)).data.role in
          ['Store Manager', 'Store manager', 'store Manager', 'store manager', 'STORE MANAGER']);
    }
    function isImageUnder(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} { allow read, write: if false; }

    // Shared path for task and order-validation evidence: either responsible
    // module can clean it up, while every signed-in staff member can submit it.
    match /proofs/{fileName} {
      allow read: if isCrew() || hasManagerAccess('ACCURACY') || hasManagerAccess('TASKS');
      allow create: if isStaff() && request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));
      allow delete: if hasManagerAccess('ACCURACY') || hasManagerAccess('TASKS');
    }
    match /employees/{fileName} {
      allow read: if isCrew() || hasManagerAccess('EMPLOYEE') || hasManagerAccess('HR');
      allow create, update: if hasManagerAccess('EMPLOYEE') && isImageUnder(10);
      allow delete: if hasManagerAccess('EMPLOYEE');
    }
    match /recipes/{fileName} {
      allow read: if isCrew() || hasManagerAccess('RECIPE');
      allow create, update: if hasManagerAccess('RECIPE') && isImageUnder(10);
      allow delete: if hasManagerAccess('RECIPE');
    }
    match /stores/certs/{fileName} {
      allow read: if isCrew() || hasManagerAccess('STORES');
      allow create, update: if hasManagerAccess('STORES') && request.resource.size < 20 * 1024 * 1024;
      allow delete: if hasManagerAccess('STORES');
    }
    match /hr_docs/{crewId}/{fileName} {
      allow read: if hasManagerAccess('HR');
      allow create, update: if hasManagerAccess('HR') && request.resource.size < 20 * 1024 * 1024;
      allow delete: if hasManagerAccess('HR');
    }
    match /training/{moduleId}/{fileName} {
      allow read: if hasTrainingAccess() || isCrew() &&
        firestore.get(/databases/(default)/documents/trainingModules/$(moduleId)).data.status == 'PUBLISHED';
      allow create, update: if hasTrainingAccess() && request.resource.size < 100 * 1024 * 1024 && request.resource.contentType.matches('video/.*');
      allow delete: if hasTrainingAccess();
    }
    // Public read is intentional: branding appears before login and kiosk unlock.
    match /settings/{fileName} {
      allow read: if true;
      allow create, update: if hasManagerAccess('HR') && isImageUnder(5);
      allow delete: if hasManagerAccess('HR');
    }
  }
}
